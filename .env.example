# ツマヅキ (Tsumazuki) — 環境変数のひな形
# cp .env.example .env してから値を入れる。.env はコミットしない。

# ── OrcaRouter（必須） ─────────────────────────────
# https://www.orcarouter.ai/redeem/AI-HACK-2026-ORCAROUTER で取得
ORCAROUTER_API_KEY=
ORCAROUTER_BASE_URL=https://api.orcarouter.ai/v1

# ルーティングモード: quality | cost | balanced | auto
ORCAROUTER_MODE=balanced

# ── Supabase ──────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── ランナー設定 ──────────────────────────────────
# 同一ドメインへの最小リクエスト間隔（ms）。公共サイトに負荷をかけない
RUNNER_DELAY_MS=4000
# 1バッチあたりの最大同時実行数（ドメイン単位の並列は常に1）
RUNNER_CONCURRENCY=3
