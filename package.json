{
  "name": "tsumazuki",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=25"
  },
  "scripts": {
    "lexicon:build": "node lexicon/src/gairaigo.ts && node lexicon/src/yasashii.ts",
    "lexicon:test": "node lexicon/src/mask.test.ts",
    "probe": "node agent/src/probe.ts",
    "sitecheck": "node agent/src/sitecheck.ts",
    "orca:smoke": "node --env-file=.env llm/smoke.ts",
    "fixture:build": "node core/fixtures/build-sample.ts && node core/fixtures/build-sample-n3.ts",
    "run": "node --env-file=.env agent/src/run.ts",
    "live": "node --env-file=.env agent/src/live.ts",
    "preflight": "node agent/src/preflight.ts",
    "batch": "node --env-file=.env agent/src/batch.ts",
    "report": "node agent/src/report.ts",
    "diagnose": "node --env-file=.env agent/src/rediagnose.ts",
    "agent:test": "node --test --experimental-test-module-mocks \"agent/test/*.test.ts\"",
    "router:test": "node --test \"llm/*.test.ts\"",
    "security:test": "node --test \"security/*.test.ts\"",
    "honeypot": "node security/honeypot.ts",
    "honeypot:live": "node security/honeypot-live.ts",
    "honeypot:serve": "node fixtures/honeypot/serve.ts",
    "overlay:test": "node agent/test/overlay-live.ts",
    "overlay:corpus": "node agent/test/overlay-corpus.ts",
    "web:data": "node scripts/build-web-data.ts",
    "web:dev": "npm --prefix web run dev -- --port ${TZ_PORT:-3000}",
    "web:build": "npm --prefix web run build",
    "web:start": "npm --prefix web run start -- --port ${TZ_PORT:-3000}",
    "tunnel": "cloudflared tunnel --url http://localhost:${TZ_PORT:-3000}"
  },
  "devDependencies": {
    "playwright": "^1.62.1"
  }
}
